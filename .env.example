# Copy to .env next to the jar (or in the folder you start it from). Real environment variables win.

# --- server
HOST=127.0.0.1
PORT=8000
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
# Long random string. If empty, everyone is signed out when the server restarts.
JWT_SECRET=change-me-to-a-long-random-string

# --- database (MySQL; the database and tables are created on first start)
# In a Docker container DB_HOST=localhost is used as host.docker.internal (the computer's MySQL).
# With docker compose, DB_HOST/DB_PORT are set to the MySQL container and DB_PASSWORD (required, not empty)
# becomes that container's root password.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=npsb_dispute
# Start-up retries an unreachable MySQL this many times, 3 s apart
DB_CONNECT_ATTEMPTS=10
# Optional full JDBC URL instead of the DB_* values:
# DATABASE_URL=jdbc:mysql://localhost:3306/npsb_dispute

# --- sending mail: "gmail" (Gmail / Google Workspace) or "smtp" (any other mail server)
MAIL_PROVIDER=gmail
# Gmail: sent through smtp.gmail.com:587 (STARTTLS), replies read through imap.gmail.com:993.
# GMAIL_APP_PASSWORD is a 16-character app password (Google Account > Security > 2-Step Verification >
# App passwords), not the normal account password. Spaces in it don't matter.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_FOLDER=INBOX
# Optional: the address shown as From (a "Send mail as" address of the Gmail account). Empty: GMAIL_ADDRESS
GMAIL_FROM=
# --- other mail server (only used with MAIL_PROVIDER=smtp, e.g. the local test mail server)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=npsb-dispute@nagad.com.bd
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_SECONDS=5

# --- reading partner replies (Gmail: imap.gmail.com; with MAIL_PROVIDER=smtp: the IMAP_* values below)
INBOX_ENABLED=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
INBOX_CHECK_SECONDS=120
INBOX_FIRST_SCAN_DAYS=30

# --- email configuration defaults (changeable in the app)
CC_EMAILS=
FOLLOWUP_DUE_DAYS=3
AUTO_FOLLOWUP_ENABLED=false
AUTO_FOLLOWUP_MAX=3
AUTO_FOLLOWUP_CHECK_SECONDS=3600

# --- security / approvals
MAKER_CHECKER=true
EMAIL_DNS_CHECK=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
VERIFICATION_CODE_MINUTES=10
PASSWORD_RESET_MINUTES=30
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=1
REFRESH_TOKEN_REMEMBER_DAYS=30

# --- built-in admin: username "admin", password "Admin@1234" (fixed; change it on My Profile after signing in).
# There is no self sign-up: this admin creates every account. Where its sign-in codes are emailed
# (empty: the Gmail account; no address at all: it signs in with the password only)
ADMIN_EMAIL=

# --- application log (logins, uploads, emails, replies, changes, errors). Never shown in the portal.
# Files app.0.log (newest) ... app.19.log, 10 MB each, in backend/app/logs. Relative paths start at the backend folder.
APP_LOG_DIR=app/logs
