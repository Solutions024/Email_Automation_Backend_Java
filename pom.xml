<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nagad</groupId>
  <artifactId>npsb-dispute-backend</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>NPSB Dispute Email Automation - backend (Java)</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <tomcat.version>10.1.31</tomcat.version>
    <jackson.version>2.17.2</jackson.version>
  </properties>

  <dependencies>
    <!-- HTTP server (embedded, no external Tomcat needed) -->
    <dependency>
      <groupId>org.apache.tomcat.embed</groupId>
      <artifactId>tomcat-embed-core</artifactId>
      <version>${tomcat.version}</version>
    </dependency>
    <!-- JSON -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- Database: connection pool + MySQL driver (H2 optional, for local tests) -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>5.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.4.0</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.2.224</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Pin slf4j-api to 2.x: a 1.7 API pulled in by another library ignores slf4j-nop and prints
         "Failed to load class org.slf4j.impl.StaticLoggerBinder" at start-up -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.13</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.13</version>
    </dependency>
    <!-- Mail: SMTP sending and IMAP reading -->
    <dependency>
      <groupId>com.sun.mail</groupId>
      <artifactId>jakarta.mail</artifactId>
      <version>2.0.1</version>
    </dependency>
    <!-- Excel files -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.3.0</version>
    </dependency>
    <!-- HTML entity decoding (partner replies) -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.18.1</version>
    </dependency>
    <!-- tests: JUnit 5, run against an in-memory H2 database (never MySQL) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>npsb-backend</finalName>
    <plugins>
      <!-- mvn test: the API tests start the backend on an in-memory H2 database -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <environmentVariables>
            <NPSB_ENV_FILE>none</NPSB_ENV_FILE>
            <DATABASE_URL>jdbc:h2:mem:npsbtest;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1</DATABASE_URL>
            <MAIL_PROVIDER>smtp</MAIL_PROVIDER>
            <SMTP_HOST>127.0.0.1</SMTP_HOST>
            <SMTP_PORT>9</SMTP_PORT>
            <SMTP_MAX_ATTEMPTS>1</SMTP_MAX_ATTEMPTS>
            <SMTP_RETRY_SECONDS>0</SMTP_RETRY_SECONDS>
            <INBOX_ENABLED>false</INBOX_ENABLED>
            <EMAIL_DNS_CHECK>false</EMAIL_DNS_CHECK>
            <JWT_SECRET>test-only-secret-not-used-anywhere-else</JWT_SECRET>
            <APP_LOG_DIR>${project.build.directory}/test-logs</APP_LOG_DIR>
          </environmentVariables>
        </configuration>
      </plugin>
      <!-- one runnable jar with all dependencies: target/npsb-backend.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.nagad.npsb.Application</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
